{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@fishmark/codemirror-adapter": ["./packages/codemirror-adapter/src/index.ts"],
      "@fishmark/editor-core": ["./packages/editor-core/src/index.ts"],
      "@fishmark/editor-model": ["./packages/editor-model/src/index.ts"],
      "@fishmark/markdown-engine": ["./packages/markdown-engine/src/index.ts"],
      "@fishmark/test-harness": ["./packages/test-harness/src/index.ts"],
      "@fishmark/workspace-application": ["./packages/workspace-application/src/index.ts"],
      "@fishmark/workspace-domain": ["./packages/workspace-domain/src/index.ts"],
      "@fishmark/workspace-infrastructure": ["./packages/workspace-infrastructure/src/index.ts"],
      "workspace-domain-test-conformance": ["./packages/workspace-domain/test/text-buffer-conformance.ts"]
    },
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/renderer/types.d.ts",
    "src/shared",
    "packages/**/*.ts",
    "scripts/vite-bundle-provenance.ts",
    "fixtures/editor-behavior/**/*.ts"
  ]
}
