      "state": "planned",
      "boundaryRuleId": "boundary.editor-model"
    },
    {
      "id": "markdown-presentation",
      "path": "packages/markdown-presentation",
      "publicEntry": "@fishmark/markdown-presentation",
      "state": "planned",
      "boundaryRuleId": "boundary.markdown-presentation"
    },
    {
