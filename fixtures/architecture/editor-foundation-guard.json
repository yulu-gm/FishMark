      "module": "packages/markdown-engine/src/parse-markdown-document.ts",
      "symbol": "parseMarkdownDocument",
      "visibility": "public",
      "role": "rich-document",
      "scope": "full-document",
      "lifecycle": {
        "state": "present-until",
        "retireIn": "RF-405"
      }
    },
    {
