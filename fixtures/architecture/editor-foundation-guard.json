      "state": "planned",
      "boundaryRuleId": "boundary.codemirror-adapter"
    }
  ],
  "rules": [
    {
      "id": "boundary.markdown-engine",
      "kind": "forbidden-imports",
      "state": "active",
      "sourcePath": "packages/markdown-engine",
      "forbiddenPackages": [
        "react",
        "react-dom",
        "electron",
        "@codemirror/*",
        "@fishmark/editor-core"
      ],
      "forbiddenPaths": [
        "src/main",
        "src/preload",
        "src/renderer",
        "packages/editor-core"
      ]
    },
    {
      "id": "boundary.editor-core",
      "kind": "forbidden-imports",
      "state": "active",
      "sourcePath": "packages/editor-core",
      "forbiddenPackages": [
        "react",
        "react-dom",
        "electron",
        "@codemirror/*"
      ],
      "forbiddenPaths": [
        "src/main",
        "src/preload",
        "src/renderer"
      ],
      "temporaryAllowedPackages": [
        {
          "id": "allow.editor-core-codemirror-until-adapter-cutover",
          "package": "@codemirror/*",
          "owner": "editor-foundation-refactor",
          "reason": "The current editor-core still owns the CodeMirror adapter and will be deleted after adapter extraction.",
          "retireIn": "RF-604"
        }
      ]
    },
    {
      "id": "boundary.renderer",
      "kind": "forbidden-imports",
      "state": "active",
      "sourcePath": "src/renderer",
      "forbiddenPackages": [],
      "forbiddenPaths": [
        "src/main",
        "src/preload"
      ]
    },
    {
      "id": "boundary.preload",
      "kind": "forbidden-imports",
      "state": "active",
      "sourcePath": "src/preload",
      "forbiddenPackages": [],
      "forbiddenPaths": [
        "src/main",
        "src/renderer"
      ]
    },
    {
      "id": "boundary.main",
      "kind": "forbidden-imports",
      "state": "active",
      "sourcePath": "src/main",
      "forbiddenPackages": [],
      "forbiddenPaths": [
        "src/preload",
        "src/renderer"
      ]
    },
    {
      "id": "boundary.public-package-entries",
      "kind": "public-package-entry",
      "state": "active",
      "sourcePaths": [
        "src",
        "packages"
      ],
      "packagesPath": "packages",
      "publicPrefix": "@fishmark/"
    }
  ],
  "exceptions": [
    {
      "id": "exception.renderer-performance-line-counter",
      "ruleId": "boundary.public-package-entries",
      "importer": "src/renderer/performance/document-derived-ui.ts",
      "specifier": "../../../packages/editor-core/src/performance/long-document-fixtures",
      "owner": "editor-foundation-refactor",
      "reason": "The current renderer performance probe shares a helper from the mixed editor-core package until that package is removed.",
      "retireIn": "RF-604"
    },
    {
      "id": "exception.renderer-performance-fixture-test",
      "ruleId": "boundary.public-package-entries",
      "importer": "src/renderer/performance/document-derived-ui.perf.test.ts",
      "specifier": "../../../packages/editor-core/src/performance/long-document-fixtures",
      "owner": "editor-foundation-refactor",
      "reason": "The legacy performance test still consumes the editor-core fixture generator until the adapter package hard cutover.",
      "retireIn": "RF-604"
    }
  ],
  "parserPolicy": {
    "enginePath": "packages/markdown-engine/src",
    "publicEntryPath": "packages/markdown-engine/src/index.ts",
    "governedSourcePaths": [
      "src",
      "packages"
    ]
  },
  "parserEntries": [
