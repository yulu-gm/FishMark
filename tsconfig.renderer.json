{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer",
    "src/shared",
    "packages/**/*.ts",
    "fixtures/editor-behavior/**/*.ts",
    "scripts/virtual-runtime-source-map.ts",
    "vite.config.ts"
  ]
}
