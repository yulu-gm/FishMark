{
  "compilerOptions": {
    "target": "ES2022",
    "paths": {
      "@fishmark/markdown-presentation": ["./packages/markdown-presentation/src/index.ts"],
      "@fishmark/codemirror-adapter": ["./packages/codemirror-adapter/src/index.ts"],
      "@fishmark/editor-model": ["./packages/editor-model/src/index.ts"],
      "@fishmark/markdown-engine": ["./packages/markdown-engine/src/index.ts"],
      "@fishmark/test-harness": ["./packages/test-harness/src/index.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
