+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import ts from "typescript";
+
+const baseline = "1654e82cd28008cc4f6ae9adec04c5a4d56389ec";
+const files = ["packages/codemirror-adapter/src/decorations/block-decorations.ts", "packages/codemirror-adapter/src/extensions/markdown.ts"];
+const hash = (source) => createHash("sha256").update(source).digest("hex");
+
+// Local diagnostic transform only. Normal product builds never load this plugin.
+export function createPlainInputExperiment(projectRoot, variant, counters = false) {
+  if (!["A", "B"].includes(variant)) throw new Error("Experiment variant must be A or B");
+  const sources = new Map(files.map((file) => [resolve(projectRoot, file).replaceAll("\\", "/"), {
+    file, baseline: execFileSync("git", ["show", `${baseline}:${file}`], { cwd: projectRoot, encoding: "utf8" }),
+    candidate: readFileSync(resolve(projectRoot, file), "utf8")
+  }]));
+  const manifest = [];
+  return {
+    manifest: () => ({ variant, baseline, counters, files: [...sources.values()].map((entry) => ({ file: entry.file,
