+import { EditorSelection, EditorState, StateEffect, Transaction } from "@codemirror/state";
+import { type DecorationSet } from "@codemirror/view";
+import { createEditorDerivedSnapshotFromCache, createEditorDerivedState } from "@fishmark/editor-model";
+import { applyIncrementalEdit, createDocumentStructureCache } from "@fishmark/markdown-engine";
+import { describe, expect, it } from "vitest";
+import { createBlockDecorations, createPlainInputScopedBlockDecorations } from "./block-decorations";
+
+function setup(source = "# Before\n\nPlain paragraph.\n\n\n# After\n\nAnother paragraph.", insert = "x", at = source.indexOf("paragraph") + 4, event = "input.type", removed = 0) {
+  const cache = createDocumentStructureCache(source);
+  const snapshot = createEditorDerivedSnapshotFromCache(cache);
+  const previous = createEditorDerivedState({ snapshot, selection: { anchor: at, head: at } });
+  const transaction = EditorState.create({ doc: source, selection: { anchor: at } }).update({
+    changes: { from: at, to: at + removed, insert }, selection: { anchor: at + insert.length },
+    annotations: Transaction.userEvent.of(event)
+  });
+  const nextCache = applyIncrementalEdit(cache, { fromOffset: at, toOffset: at + removed, insertedText: insert }).cache;
+  const nextSnapshot = createEditorDerivedSnapshotFromCache(nextCache);
+  const next = createEditorDerivedState({ snapshot: nextSnapshot, selection: { anchor: at + insert.length, head: at + insert.length } });
+  const presentation = { mode: "editing" as const, revealed: null };
+  const oldSet = createBlockDecorations({ snapshot, ...previous, hasEditorFocus: true, headingMarkerPresentation: presentation }).decorationSet;
+  const options = {
+    snapshot: nextSnapshot, ...next, hasEditorFocus: true,
+    baseDecorationSet: oldSet.map(transaction.changes), previousDerivedState: previous,
+    transaction, compositionActive: false,
+    headingMarkerPresentation: presentation, previousHeadingMarkerPresentation: presentation,
+    viewMode: "wysiwym" as const, previousViewMode: "wysiwym" as const
+  };
+  return { options, next };
+}
+
+function allRanges(set: DecorationSet) {
+  const result: unknown[] = [];
+  for (let cursor = set.iter(); cursor.value; cursor.next()) {
+    result.push({ from: cursor.from, to: cursor.to, spec: cursor.value.spec });
+  }
+  return result.sort((a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b)));
+}
+
+describe("plain input decoration reuse", () => {
+  it.each(["x", "中", "7", "𐐀"])("matches every full decoration spec and position for %s", (insert) => {
+    const { options } = setup(undefined, insert);
+    const scoped = createPlainInputScopedBlockDecorations(options);
+    expect(scoped).not.toBeNull();
+    expect(allRanges(scoped!.decorationSet)).toEqual(allRanges(createBlockDecorations(options).decorationSet));
+  });
+
+  it.each(["Plain paragraph.", "# Before\n\nPlain paragraph.\n\n# After", `Plain ${"paragraph ".repeat(200)}end.\n\n# After`])("preserves end and adjacent line decorations: %s", (source) => {
+    const at = source.indexOf("\n\n# After") < 0 ? source.length : source.indexOf("\n\n# After");
+    const { options } = setup(source, "x", at);
+    const scoped = createPlainInputScopedBlockDecorations(options);
+    expect(scoped).not.toBeNull();
+    expect(allRanges(scoped!.decorationSet)).toEqual(allRanges(createBlockDecorations(options).decorationSet));
+  });
+
+  it("matches full rebuilds through repeated mapped edits", () => {
+    let source = "# Before\n\nPlain paragraph.\n\n\n# After";
+    let at = source.indexOf("paragraph") + 4;
+    let set: DecorationSet | null = null;
+    for (let i = 0; i < 30; i++) {
+      const { options, next } = setup(source, i % 2 ? "中" : "x", at);
+      if (set) options.baseDecorationSet = set.map(options.transaction.changes);
+      set = createPlainInputScopedBlockDecorations(options)!.decorationSet;
+      expect(allRanges(set)).toEqual(allRanges(createBlockDecorations(options).decorationSet));
+      source = next.source;
+      at++;
+    }
+  });
+
+  it("retains complete decoration equivalence in stable reading mode", () => {
+    const { options } = setup();
+    const presentation = { mode: "reading" as const, revealed: null };
+    const old = options.previousDerivedState;
+    options.baseDecorationSet = createBlockDecorations({ snapshot: old.activeBlockState.snapshot, ...old, hasEditorFocus: true, headingMarkerPresentation: presentation }).decorationSet.map(options.transaction.changes);
+    const readingOptions = { ...options, headingMarkerPresentation: presentation, previousHeadingMarkerPresentation: presentation };
+    const scoped = createPlainInputScopedBlockDecorations(readingOptions);
+    expect(scoped).not.toBeNull();
+    expect(allRanges(scoped!.decorationSet)).toEqual(allRanges(createBlockDecorations(readingOptions).decorationSet));
+  });
+
+  it("rejects raw CRLF sources that disagree with the transaction document", () => {
+    expect(createPlainInputScopedBlockDecorations(setup("# Before\r\n\r\nPlain paragraph.\r\n\r\n# After").options)).toBeNull();
+  });
+
+  it("rejects multiple changes and selection ranges", () => {
+    const { options } = setup();
+    const at = options.previousDerivedState.selection.head;
+    const multiple = options.transaction.startState.update({ changes: [{ from: at, insert: "x" }, { from: at + 2, insert: "y" }], selection: { anchor: at + 1 }, userEvent: "input.type" });
+    expect(createPlainInputScopedBlockDecorations({ ...options, transaction: multiple, source: multiple.newDoc.toString() })).toBeNull();
+    const state = EditorState.create({ doc: options.previousDerivedState.source, selection: EditorSelection.create([EditorSelection.cursor(at), EditorSelection.cursor(at + 2)]), extensions: EditorState.allowMultipleSelections.of(true) });
+    const transaction = state.update({ changes: { from: at, insert: "x" }, userEvent: "input.type" });
+    expect(createPlainInputScopedBlockDecorations({ ...options, transaction })).toBeNull();
+  });
+
+  it.each(["input.type.compose", "input.paste", "undo", "redo", "input.complete", "input.command"])("rejects provenance %s", (event) => {
+    expect(createPlainInputScopedBlockDecorations(setup(undefined, "x", undefined, event).options)).toBeNull();
+  });
+  it.each(["xx", "\n", " ", "*", "", "😀"])("rejects nonordinary insertion %j", (insert) => {
+    expect(createPlainInputScopedBlockDecorations(setup(undefined, insert).options)).toBeNull();
+  });
+  it("rejects deletion, replacement, start insertion and changed line structure", () => {
+    expect(createPlainInputScopedBlockDecorations(setup(undefined, "x", undefined, "input.type", 1).options)).toBeNull();
+    expect(createPlainInputScopedBlockDecorations(setup(undefined, "", undefined, "input.type", 1).options)).toBeNull();
+    expect(createPlainInputScopedBlockDecorations(setup("Plain paragraph.", "x", 0).options)).toBeNull();
+    expect(createPlainInputScopedBlockDecorations(setup("# Title\n\nPlain paragraph.", "x", 4).options)).toBeNull();
+  });
+
+  it.each([
+    "**rich**", "[link](https://example.test)", "`code`", "![alt](image.png)", "$math$",
+    "> Quote", "- List", "```\ncode\n```", "---", "$$\nmath\n$$",
+    "<img src='x'>", "| A | B |\n| --- | --- |\n| C | D |",
+    "[ref]: https://example.test", "[^n]: Footnote", "Multiline\nparagraph"
+  ])("rejects other document dependencies or complex blocks %s", (other) => {
+    expect(createPlainInputScopedBlockDecorations(setup(`Plain paragraph.\n\n${other}`).options)).toBeNull();
+  });
+
+  it("rejects composition, blur, source mode, reveal, effects and unexpected selection", () => {
+    const { options } = setup();
+    expect(createPlainInputScopedBlockDecorations({ ...options, compositionActive: true })).toBeNull();
+    expect(createPlainInputScopedBlockDecorations({ ...options, hasEditorFocus: false })).toBeNull();
+    expect(createPlainInputScopedBlockDecorations({ ...options, previousViewMode: "source" })).toBeNull();
+    expect(createPlainInputScopedBlockDecorations({ ...options, viewMode: "source" })).toBeNull();
+    expect(createPlainInputScopedBlockDecorations({ ...options, previousHeadingMarkerPresentation: { mode: "reading", revealed: null } })).toBeNull();
+    expect(createPlainInputScopedBlockDecorations({ ...options, headingMarkerPresentation: { mode: "editing", revealed: { from: 0, to: 2 } } })).toBeNull();
+    const effect = StateEffect.define<null>();
+    const transaction = options.transaction.startState.update({ changes: { from: options.previousDerivedState.selection.head, insert: "x" }, effects: effect.of(null), annotations: Transaction.userEvent.of("input.type") });
+    expect(createPlainInputScopedBlockDecorations({ ...options, transaction })).toBeNull();
+    expect(createPlainInputScopedBlockDecorations({ ...options, activeBlockState: { ...options.activeBlockState, selection: { anchor: 0, head: 1 } } })).toBeNull();
+    expect(createPlainInputScopedBlockDecorations({ ...options, previousDerivedState: { ...options.previousDerivedState, selection: { anchor: 0, head: 0 } } })).toBeNull();
+  });
+});
